# ===================================================
# 퀀트 투자 환경설정
# 복사해서 .env 파일로 저장하세요: cp .env.example .env
# ===================================================

# ---- 서버 ----
PORT=3000
HOST=127.0.0.1

# ---- 데이터 소스 ----
# 'naver' (기본, 키 불필요) 또는 'kis' (한국투자증권)
DATA_SOURCE=naver

# ---- KIS Developers (선택) ----
# 발급처: https://apiportal.koreainvestment.com/
# .env에 두 키가 모두 있으면 자동으로 KIS 모드 활성화
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_PAPER=true

# ---- 스케줄 ----
# 장 마감 후 자동 갱신 시각 (KST, 24h 형식)
# 평일 17:00 = 매일 장 마감(15:30) + 1.5시간 버퍼
UPDATE_HOUR=17
UPDATE_MINUTE=0

# ---- 유니버스 ----
# KOSPI, KOSDAQ 둘 다 기본. 콤마 구분
MARKETS=KOSPI,KOSDAQ
TOP_N=20
BACKFILL_YEARS=2
